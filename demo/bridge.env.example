# =============================================================================
# Hyperlane Dusk <-> EVM local bridge environment
# =============================================================================
# Copy to demo/.env.bridge (gitignored) and fill in the two secrets below:
#
#   cp demo/bridge.env.example demo/.env.bridge
#
# Sourced by start-env.sh, stop-env.sh, deploy.sh, bridge.sh and the E2E
# scripts. Every value can also be overridden from the environment.

# ── Project paths ────────────────────────────────────────────────────────────

DUSK_DIR="${DUSK_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# Must be the same checkout the contracts build against (../../rusk-private).
RUSK_DIR="${RUSK_DIR:-$DUSK_DIR/../../rusk-private}"
EXPLORER_DIR="${EXPLORER_DIR:-$DUSK_DIR/../../explorer}"
SOLIDITY_DIR="${SOLIDITY_DIR:-$DUSK_DIR/../hyperlane-monorepo/solidity}"

# ── Binaries ─────────────────────────────────────────────────────────────────

DUSK_TX="${DUSK_TX:-$DUSK_DIR/target/release/dusk-tx}"
WASM_DIR="${WASM_DIR:-$DUSK_DIR/target/contract/wasm32-unknown-unknown/release}"

# ── Keys ─────────────────────────────────────────────────────────────────────

# Encrypted Dusk consensus key for a Moonlight account that is funded in the
# local genesis state. Deploys and Dusk-side demo transactions are signed
# with it.
CONSENSUS_KEYS="${CONSENSUS_KEYS:-$DUSK_DIR/e2e/consensus.keys}"
CONSENSUS_PASSWORD="${CONSENSUS_PASSWORD:-}"

# Genesis state archive loaded by Rusk.
RUSK_STATE="${RUSK_STATE:-/tmp/example.state}"

# ── Ports ────────────────────────────────────────────────────────────────────

RUSK_HTTP_PORT="${RUSK_HTTP_PORT:-8080}"
ANVIL_PORT="${ANVIL_PORT:-8545}"
DUSK_EXPLORER_PORT="${DUSK_EXPLORER_PORT:-5173}"
EVM_EXPLORER_PORT="${EVM_EXPLORER_PORT:-5100}"

# ── Derived URLs ─────────────────────────────────────────────────────────────

DUSK_RUES_URL="http://localhost:${RUSK_HTTP_PORT}/"
ANVIL_RPC="http://localhost:${ANVIL_PORT}"
DUSK_EXPLORER_URL="http://localhost:${DUSK_EXPLORER_PORT}"
EVM_EXPLORER_URL="http://localhost:${EVM_EXPLORER_PORT}"

# ── Chain domains ────────────────────────────────────────────────────────────

# Hyperlane requires known domain IDs to use their canonical names, so the
# local chains use IDs outside the known list. That lets them be named
# "dusk" and "anvil".
DUSK_DOMAIN="${DUSK_DOMAIN:-4242}"
EVM_DOMAIN="${EVM_DOMAIN:-31338}"
ANVIL_CHAIN_ID="${ANVIL_CHAIN_ID:-31338}"

# ── EVM account ──────────────────────────────────────────────────────────────

# Anvil's default account #0. Anvil prints its private key on startup.
ANVIL_PRIVATE_KEY="${ANVIL_PRIVATE_KEY:-}"
ANVIL_DEPLOYER="0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"

# ── Token ────────────────────────────────────────────────────────────────────

TOKEN_NAME="${TOKEN_NAME:-Wrapped DUSK}"
TOKEN_SYMBOL="${TOKEN_SYMBOL:-wDUSK}"
TOKEN_DECIMALS="${TOKEN_DECIMALS:-18}"
INITIAL_SUPPLY="${INITIAL_SUPPLY:-10000000000000000000}"  # 10 tokens

# ── State files ──────────────────────────────────────────────────────────────

BRIDGE_STATE_FILE="${BRIDGE_STATE_FILE:-/tmp/hyperlane-bridge-state.json}"
PID_FILE="${PID_FILE:-/tmp/hyperlane-bridge-pids}"

# ── Docker ───────────────────────────────────────────────────────────────────

OTTERSCAN_CONTAINER="otterscan-bridge"
