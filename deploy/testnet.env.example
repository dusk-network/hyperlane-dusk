# =============================================================================
# Dusk testnet deployment settings for deploy/testnet.sh
# =============================================================================
# Copy to deploy/testnet.env (gitignored) and fill in. Secrets are read from
# the environment, never from this file: export DUSK_CONSENSUS_PASSWORD and
# EVM_DEPLOYER_KEY in the shell that runs the script.

# Name of this deployment. State and agent configs go to deploy/out/<name>/.
DEPLOY_NAME="${DEPLOY_NAME:-dusk-testnet-sepolia}"

# ── Dusk ─────────────────────────────────────────────────────────────────────

DUSK_RUES_URL="${DUSK_RUES_URL:-https://testnet.nodes.dusk.network/}"
DUSK_EXPECTED_CHAIN_ID="${DUSK_EXPECTED_CHAIN_ID:-2}"
# Hyperlane domain ID for Dusk testnet. 0x4455534B ("DUSK") is kept for
# mainnet and testnet takes the next ID, as Solana does (SolM, SolN). Neither
# is used in the Hyperlane registry as of v26.3.0; check again before
# registering.
DUSK_DOMAIN="${DUSK_DOMAIN:-1146442572}"
# Encrypted consensus keys of the funded deployer account, as exported by
# rusk-wallet. The password comes from DUSK_CONSENSUS_PASSWORD.
DUSK_KEYS="${DUSK_KEYS:-}"
# Per-transaction gas limit. Deploys cost 100 gas per WASM byte; the Mailbox
# needs about 25M. The limit times the gas price must be in the deployer's
# balance when each transaction is submitted; unused gas is refunded.
DUSK_GAS_LIMIT="${DUSK_GAS_LIMIT:-50000000}"
# Deploys must pay at least the network's min_deployment_gas_price (2000).
DUSK_GAS_PRICE="${DUSK_GAS_PRICE:-2000}"
# Gas settings written into the agent configs. Ordinary transactions only
# need a price above zero.
# The relayer's limit for `process`. A relayed transfer costs about 1.95M gas
# plus 0.22M per signature the Dusk ISM checks (EVM_ORIGIN_THRESHOLD): 2.2M,
# or 0.0022 DUSK at 1 LUX/gas, for one signature. A failed transaction pays
# its whole limit, and one fails whenever someone else delivers the message
# first, so keep this low. `agent-configs` refuses less than 1.5 times the
# cost at EVM_ORIGIN_THRESHOLD, which must be the threshold of the ISM
# deployed on chain; 5M covers thresholds up to 6.
DUSK_RELAYER_GAS_LIMIT="${DUSK_RELAYER_GAS_LIMIT:-5000000}"
# The relayer delivers to Dusk one at a time: dusk-tx signs each delivery
# with the account's next nonce and returns once it is in a block, so one
# relayer key delivers about a message every two blocks, 3 a minute (a burst
# of 39 took 778 s in docs/costs.md's measurement). The agents' pipelined
# deliveries, several transactions of the account sharing a block, took a
# burst of 40 in 85.7 s there, but they are experimental: agent-configs
# leaves them off, and they stay off on testnet and mainnet for now
# (docs/operations.md, Deliveries to Dusk).
# The validators' limit, for their one-time announcement (about 2.1M gas).
DUSK_AGENT_GAS_LIMIT="${DUSK_AGENT_GAS_LIMIT:-30000000}"
# The agents' gas price in LUX, which is also the Dusk gas price the EVM IGP
# charges for.
DUSK_AGENT_GAS_PRICE="${DUSK_AGENT_GAS_PRICE:-1}"

# Validators the Dusk Mailbox trusts for messages from the EVM chain. The
# default is Hyperlane's own Sepolia validator, so EVM -> Dusk needs no
# validators of ours. Once deployed, the ISM on chain must keep exactly these
# validators and this threshold, or the script stops: if the owner changes
# them on chain, change them here too.
EVM_ORIGIN_VALIDATORS="${EVM_ORIGIN_VALIDATORS:-0x3c659e0fe8d01b80d7828b421630085777346e7c}"
EVM_ORIGIN_THRESHOLD="${EVM_ORIGIN_THRESHOLD:-1}"

# Our validators for messages from Dusk (comma-separated EVM addresses). The
# EVM-side route verifies Dusk-origin messages against this set.
DUSK_ORIGIN_VALIDATORS="${DUSK_ORIGIN_VALIDATORS:-}"
DUSK_ORIGIN_THRESHOLD="${DUSK_ORIGIN_THRESHOLD:-}"

# ── Relaying fees ────────────────────────────────────────────────────────────
# The relayer relays any message between the two chains once it is paid for:
# each chain's IGP charges the sender, in that chain's token, for the gas the
# relayer spends delivering it on the other (docs/costs.md#fee-coverage). Both
# IGPs compute
#
#   payment = gas x gas price x token exchange rate / 1e10
#
# where gas is the message's gas limit plus the destination's overhead, the
# gas price is in the destination's smallest unit (wei, or LUX), and the
# token exchange rate converts that into the origin's (LUX, or wei), scaled by
# 1e10. DUSK has 9 decimals, ETH 18. deploy/testnet.sh derives the rates from
# the prices below and adds the operator's margin to them, since neither IGP
# has a markup field:
#
#   Dusk IGP: LUX per wei x 1e10 = 10 x ETH_DUSK_PRICE_RATIO x (1 + margin)
#   EVM IGP:  wei per LUX x 1e10 = 1e19 / ETH_DUSK_PRICE_RATIO x (1 + margin)
#
# both rounded up. `bash deploy/testnet.sh fees` shows what these settings
# charge, and `dusk-igp` and `evm-igp` compare the deployed IGPs with them
# and, with --apply, update them. Update the prices when they move.

# DUSK per ETH: the ETH price over the DUSK price. 25,000 is ETH at 2,500 USD
# and DUSK at 0.10 USD. Hyperlane's own price feed had ETH at 2,461 USD on
# 2026-11-10 (typescript/infra/config/environments/mainnet3/tokenPrices.json
# in the monorepo); DUSK traded between about 0.04 and 0.34 USD in 2026.
ETH_DUSK_PRICE_RATIO="${ETH_DUSK_PRICE_RATIO:-25000}"
# The gas price the relayer pays on the EVM chain, in wei. 1 gwei is twice
# what Hyperlane's own Ethereum gas oracle used in November 2026 (0.5 gwei,
# mainnet3/gasPrices.json), for priority fees and short spikes. Sepolia's
# price is lower and its ETH free; this prices delivery as on mainnet.
EVM_GAS_PRICE_WEI="${EVM_GAS_PRICE_WEI:-1000000000}"
# The operator's margin, in basis points of the relaying cost, added to both
# exchange rates. 5000 (50%) is the margin Hyperlane adds to its own IGPs'
# rates (EXCHANGE_RATE_MARGIN_PCT): it absorbs price moves between updates,
# and what it doesn't absorb is the operator's earnings.
OPERATOR_MARGIN_BPS="${OPERATOR_MARGIN_BPS:-5000}"
# EVM gas the Dusk IGP charges a transfer for, on top of the 50,000 it
# charges any message without hook metadata (the warp routes send none).
# Delivering a transfer, Mailbox.process with DUSK_ORIGIN_THRESHOLD-of-n
# MessageId multisig verification and the token's handle, takes at most
# 420,000 + 7,500 per signature + 2,500 per validator on Sepolia, which
# charges about 111,000 gas for each storage slot a delivery creates: the
# delivery record, a new holder's balance and a token's first supply.
# Sepolia estimated 424,972 gas for a token's first mint at 1 of 2, and
# the relayer delivers a message from Dusk once what it paid for covers
# two-thirds of its estimate (docs/costs.md, Fee coverage). The overhead is
# the most a delivery takes, less the 50,000. 405,000 covers up to 3 of 5,
# and preflight stops when it is too low for DUSK_ORIGIN_THRESHOLD and
# DUSK_ORIGIN_VALIDATORS. Every route's Sepolia token is a HypERC20, so the
# DUSK and the Dusk-issued tokens' transfers cost the same there.
DUSK_IGP_GAS_OVERHEAD="${DUSK_IGP_GAS_OVERHEAD:-405000}"
# Dusk gas the EVM IGP charges a transfer to Dusk for (the EVM route asks for
# none on top): a relayed `process`, 1,950,000 plus 220,000 per signature the
# Dusk ISM checks, the route's handle included. 2,170,000 is
# EVM_ORIGIN_THRESHOLD 1; preflight stops when it is too low for it.
EVM_IGP_GAS_OVERHEAD="${EVM_IGP_GAS_OVERHEAD:-2170000}"
# Who can claim the fees (docs/operations.md). The EVM IGP pays
# EVM_IGP_BENEFICIARY, an address. On Dusk the IGP and the ProtocolFee pay
# DUSK_FEE_BENEFICIARY, a base58 Moonlight address, which must sign its
# claims. deploy sets them; left empty, the contracts pay whom they already
# do, the deployer on each side when they are first deployed.
EVM_IGP_BENEFICIARY="${EVM_IGP_BENEFICIARY:-}"
DUSK_FEE_BENEFICIARY="${DUSK_FEE_BENEFICIARY:-}"

# ── EVM chain with existing Hyperlane core contracts ────────────────────────
# Defaults are Sepolia's, from the Hyperlane registry
# (chains/sepolia/{metadata,addresses}.yaml).

EVM_CHAIN_NAME="${EVM_CHAIN_NAME:-sepolia}"
EVM_RPC="${EVM_RPC:-https://ethereum-sepolia.publicnode.com}"
EVM_CHAIN_ID="${EVM_CHAIN_ID:-11155111}"
EVM_DOMAIN="${EVM_DOMAIN:-11155111}"
EVM_REORG_PERIOD="${EVM_REORG_PERIOD:-2}"
# The most blocks one log query to EVM_RPC spans, when the checks read the
# IGP's QuoteSignerAdded events (docs/operations.md). The relayer indexes in
# chunks of 1,999.
EVM_LOG_BLOCK_RANGE="${EVM_LOG_BLOCK_RANGE:-1999}"
EVM_BLOCK_TIME="${EVM_BLOCK_TIME:-13}"
EVM_MAILBOX="${EVM_MAILBOX:-0xfFAEF09B3cd11D9b20d1a19bECca54EEC2884766}"
EVM_MERKLE_TREE_HOOK="${EVM_MERKLE_TREE_HOOK:-0x4917a9746A7B6E0A57159cCb7F5a6744247f2d0d}"
EVM_VALIDATOR_ANNOUNCE="${EVM_VALIDATOR_ANNOUNCE:-0xE6105C59480a1B7DD3E4f28153aFdbE12F4CfCD9}"
# Hyperlane's StaticMessageIdMultisigIsmFactory. Leave empty to deploy a
# StorageMessageIdMultisigIsm from source instead.
EVM_ISM_FACTORY="${EVM_ISM_FACTORY:-0xFEb9585b2f948c1eD74034205a7439261a9d27DD}"
# Hyperlane's StaticAggregationHookFactory, which deploys the EVM route's
# hook: EVM_MERKLE_TREE_HOOK, whose tree the validators sign, then our IGP.
# Sepolia's Mailbox requires only its ProtocolFee hook, and the route's hook
# replaces the default one, which is what inserts into that tree. Leave empty
# to deploy a factory as well.
EVM_AGGREGATION_HOOK_FACTORY="${EVM_AGGREGATION_HOOK_FACTORY:-0xaEDCF9C2BB12D9bb681CC55DbFE9FF30b2De8d77}"
# Hooks under the EVM Mailbox's required hook that were deployed before
# Hyperlane's hooks had hookType(), so they can't say what they are, as
# comma-separated address=kind pairs. The only kind is protocol_fee: a
# ProtocolFee takes its fee and inserts nothing into the Merkle tree, and
# deploy checks that each listed hook answers protocolFee(). Any other hook
# without a type still stops deploy. Sepolia's Mailbox requires Hyperlane's
# ProtocolFee at 0x13AC…9DB5, which predates hookType(); Hyperlane's
# testnet4 core verification record names it ProtocolFee.
EVM_TYPELESS_HOOKS="${EVM_TYPELESS_HOOKS:-0x13AC3349Cb159fE86A22cf42DdA803D9f7309DB5=protocol_fee}"

# ── Agents ───────────────────────────────────────────────────────────────────
# Paths written into the agent configs: where each agent keeps its database
# and event cursors, and the Dusk signer key file it reads (see
# `dusk-tx export-signer-key`).
AGENT_STATE_DIR="${AGENT_STATE_DIR:-/var/lib/hyperlane}"
DUSK_SIGNER_KEY_FILE="${DUSK_SIGNER_KEY_FILE:-/run/secrets/dusk-signer.key}"
# Multicall for Dusk (dusk-multicall v0.1.0): one contract query that runs
# many reads. The agents batch their contract reads through it when their
# config names it (batchContractAddress), and fall back to single queries
# when it doesn't. It runs at this ID on mainnet and testnet: the ID commits
# to its Wasm, deploy nonce 0 and its published owner, not to the chain.
# `preflight` and `agent-configs` check it answers `version` with 1, and
# leave it out of the configs, with a warning, on a chain without it. Set it
# empty to leave it out.
DUSK_MULTICALL="${DUSK_MULTICALL-93de287b7d349d678a0038fe7772e8960e1a84a1b5da2d0b1f62f532616ce1d4}"

# Hyperlane Solidity sources, used to deploy the EVM contracts.
SOLIDITY_DIR="${SOLIDITY_DIR:-$DUSK_DIR/../hyperlane-monorepo/solidity}"
